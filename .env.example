# ---------------------------------------------------------------------------
# LLD Practice Platform - environment configuration
# Copy this file to `.env` (`cp .env.example .env`) and edit as needed.
#
# EVERY VALUE BELOW IS OPTIONAL. With no .env file at all the platform runs
# end-to-end using the deterministic Heuristic evaluator (demo mode).
# ---------------------------------------------------------------------------

# Which judgment evaluator to use for design feedback.
#   auto      (default) use the LLM if an API key is present, otherwise heuristic
#   heuristic force the deterministic offline evaluator (great for demos/tests)
#   llm       force the LLM evaluator; startup fails loudly if no key is set
EVALUATOR=auto

# --- LLM provider (only needed if you want real AI evaluation) --------------
# Provide ONE of the following keys. Never commit real keys.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: point at a custom Anthropic-compatible endpoint (e.g. an agent router)
# ANTHROPIC_BASE_URL=https://your-router.example.com
# OPENAI_BASE_URL=https://your-router.example.com

# Optional model overrides
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini

# Milliseconds before an LLM evaluation is abandoned and the attempt is
# marked FAILED (the learner can then retry evaluation; the submission is kept).
LLM_TIMEOUT_MS=60000

# --- Server -----------------------------------------------------------------
PORT=4000
# SQLite file location, relative to the repository root.
DATABASE_PATH=data/lld-practice.db

# Origin allowed to call the API via CORS. In development the Vite dev server
# proxies /api, so this only matters when the web build is served from a
# different origin (e.g. Vercel). Set this to your Vercel deployment URL.
# WEB_ORIGIN=https://your-app.vercel.app
WEB_ORIGIN=http://localhost:5173

# Artificial delay (ms) added to the heuristic evaluator so the SUBMITTED ->
# EVALUATING -> COMPLETED transition is visible while demoing. Set 0 to disable.
DEMO_EVALUATION_DELAY_MS=1200
